classDiagram
class Personaje {
  <<abstract>>
  -_x
  -_y
  -_velocidad
  +mover(dx, dy)
  +update()*
}
class Prisionero {
  +update()
  +recoger_llave()
}
class Guardia {
  +update()
  +puede_detectar(prisionero)
}
class HabilidadCarrera {
  +activar()
  +actualizar(dt)
}
class EstadoJuego {
  <<abstract>>
  +manejar_entrada(tecla)*
  +actualizar(dt, teclas)*
}
class Puntaje {
  -_valor
  -_observadores
  +suscribir(observador)
  +desuscribir(observador)
  +sumar(cantidad)
  +reiniciar()
  -_notificar()
}
class ObservadorPuntaje {
  <<abstract>>
  +actualizar_puntaje(valor)*
}
class PanelPuntaje {
  +valor
  +actualizar_puntaje(valor)
}
